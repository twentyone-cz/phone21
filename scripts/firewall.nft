#!/usr/sbin/nft -f
#
# Phone21 — firewall brány na LXC (nftables).
#
# Z internetu není dostupné nic; telefonování jen z privátní sítě; správa
# z domácí sítě i z privátní sítě. Vlastní tabulka `inet gsm2sip`
# koexistuje s pravidly dockeru, nikdy se nevolá `flush ruleset`.
#
# Nasazení a rollback: scripts/install-firewall.sh.

# --- Parametry ---------------------------------------------------------------
# MGMT_NET = sítě, ze kterých se brána spravuje (SSH, web UI).
# PŘED NASAZENÍM UPRAV na svou správcovskou síť.
define MGMT_NET   = { 192.168.1.0/24 }
# Rozhraní privátní sítě (CockScale).
define TUN_IFS    = { "tailscale0" }
define SIP_PORT   = 5060           # signalizace
define RTP_PORTS  = 10000-10100    # zvuk hovorů
define WEBUI_PORT = 8090           # .env WEBUI_PORT
define PROV_PORT  = 8091           # provisioning telefonu (jednorázový token)

# Idempotence: tabulku vyrob prázdnou, smaž a nadefinuj.
table inet gsm2sip {}
delete table inet gsm2sip

table inet gsm2sip {

  chain input {
    type filter hook input priority filter; policy drop;

    # Stavové základy.
    ct state established,related accept
    ct state invalid drop
    iif lo accept

    # ICMP — diagnostika a PMTU/ND.
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept

    # DHCP klient.
    udp sport 67 udp dport 68 accept
    udp sport 547 udp dport 546 accept

    # --- Z veřejné IP nesmí přijít nic -----------------------------------

    # --- Správa: LAN i tunel ---------------------------------------------
    ip saddr $MGMT_NET tcp dport 22 accept
    iifname $TUN_IFS tcp dport 22 accept

    ip saddr $MGMT_NET tcp dport $WEBUI_PORT accept
    iifname $TUN_IFS tcp dport $WEBUI_PORT accept

    # Nastavení telefonu: jen z domácí sítě, chrání ho jednorázový token.
    ip saddr $MGMT_NET tcp dport $PROV_PORT accept

    # --- Telefonování: výhradně z privátní sítě --------------------------
    iifname $TUN_IFS tcp dport $SIP_PORT accept
    iifname $TUN_IFS udp dport $SIP_PORT accept
    iifname $TUN_IFS udp dport $RTP_PORTS accept

    # Zahozené pakety zalogovat, ale s limitem (log je v dmesg / journalu).
    limit rate 5/minute burst 5 packets \
      log prefix "gsm2sip-fw-drop: " level info
  }

  chain forward {
    type filter hook forward priority filter; policy accept;

    # Z privátní sítě se dál (do domácí sítě, do internetu) nejde.
    iifname $TUN_IFS oifname != $TUN_IFS drop
  }
}
