# GSM2SIP — parametry (zkopíruj na `cp .env.example .env`, doplň, NIKDY necommituj .env)

# SIP účet softphonu (Linphone). Heslo min. 16 znaků, vygeneruj:
#   openssl rand -base64 24
# Soubor čte shell (configure.sh) i docker compose — obsahuje-li heslo jiné
# znaky než [A-Za-z0-9+/=], obal ho jednoduchými uvozovkami: 'takhle'.
SIP_USER=softphone
SIP_PASSWORD=change-me
# Doména/IP, na kterou je SIP účet v softphonu registrovaný (identita účtu).
# Jde do To hlavičky SMS zpráv — liblinphone podle ní řadí konverzace k účtu;
# špatná hodnota = zpráva se uloží, ale konverzace není vidět.
SIP_DOMAIN=doplnit-adresu-brany

# MBN carrier profil modemu (VoLTE): auto = vybrat podle operátora SIM
# z tabulky ve scripts/mbn-profile.sh, off = nechat autoselect modemu,
# nebo konkrétní název profilu (scripts/mbn-profile.sh list).
# Instalace služby: sudo scripts/install-mbn.sh (vyžaduje /dev/cdc-wdm0).
MBN_PROFILE=auto

# Národní předvolba (bez +) pro normalizaci čísel na E.164 — všechno, co vidí
# Linphone (CallerID, odesílatel SMS, potvrzenky), brána sjednocuje na +420...
# tvar, aby se konverzace a kontakty nerozpadaly na dvě vlákna:
COUNTRY_CODE=420

# Kam configure.sh vygeneruje runtime konfiguraci Asterisku a odkud ji
# docker-compose mountuje. Mimo umbreld app adresář (ten se při updatu
# appky přepisuje). Pro samostatný stack stačí default:
ASTERISK_CONF_DIR=./runtime/asterisk

# AMI (interní rozhraní Asterisku pro web UI; jen localhost) a web UI heslo.
# Obojí vygeneruj: openssl rand -base64 24
AMI_PASSWORD=change-me
WEBUI_PASSWORD=change-me
# Port web UI (poslouchá na všech adresách LXC — chránit na síti, jen LAN/WG):
#WEBUI_PORT=8090

# Privátní síť (CockScale) — login server pro tailnet sidecar
# (docker-compose.tailscale.yml); auth klíč se vkládá ve webui, záložka Síť:
#COCKSCALE_URL=https://cockscale.twentyone.cz

# Override image. Default gsm2sip-asterisk:local se buildí lokálně
# (sudo docker compose build). Nouzový návrat na původní image (pozor:
# segfault při DTMF, bez dsci):
#ASTERISK_IMAGE=starší image

# --- Informativní (zatím nepoužívá žádný skript, drží kontext) ---------------
# PIN SIM: doporučeno PIN úplně vypnout (AT+CLCK="SC",0,"<pin>") — brána PIN neřeší.
#SIM_PIN=
# Operátor SIM (O2 / T-Mobile / Vodafone) — kvůli VoLTE postupu ve Fázi 2:
#OPERATOR=
# Tunel pro vzdálený přístup (tailscale / wireguard), Fáze 5:
#TUNNEL=tailscale
