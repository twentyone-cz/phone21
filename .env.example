# GSM2SIP — parametry (zkopíruj na `cp .env.example .env`, doplň, NIKDY necommituj .env)

# SIP účet softphonu (Linphone). Heslo min. 16 znaků, vygeneruj:
#   openssl rand -base64 24
# Soubor čte shell (configure.sh) i docker compose — obsahuje-li heslo jiné
# znaky než [A-Za-z0-9+/=], obal ho jednoduchými uvozovkami: 'takhle'.
SIP_USER=softphone
SIP_PASSWORD=change-me

# Kam configure.sh vygeneruje runtime konfiguraci Asterisku a odkud ji
# docker-compose mountuje. Mimo umbreld app adresář (ten se při updatu
# appky přepisuje). Pro samostatný stack stačí default:
ASTERISK_CONF_DIR=./runtime/asterisk

# Override image. Default gsm2sip-asterisk:local se buildí lokálně
# (sudo docker compose build). Nouzový návrat na původní image (pozor:
# segfault při DTMF, bez dsci):
#ASTERISK_IMAGE=starší image

# --- Informativní (zatím nepoužívá žádný skript, drží kontext) ---------------
# PIN SIM: doporučeno PIN úplně vypnout (AT+CLCK="SC",0,"<pin>") — brána PIN neřeší.
#SIM_PIN=
# Operátor SIM (O2 / T-Mobile / Vodafone) — kvůli VoLTE postupu ve Fázi 2:
#OPERATOR=
# Tunel pro vzdálený přístup (tailscale / wireguard), Fáze 5:
#TUNNEL=tailscale
