+/* Phone21: BUSY / NO ANSWER result code of ATD as the hangup cause of an
+ * unanswered outgoing call (only calls with early audio allowed). The hangup
+ * itself is still queued on release, so the network announcement is not cut. */
+static void early_audio_set_cause(struct pvt* const pvt, const int cause)
+{
+    struct cpvt* cpvt;
+    AST_LIST_TRAVERSE(&pvt->chans, cpvt, entry) {
+        if (cpvt->channel && CPVT_DIR_OUTGOING(cpvt) && CPVT_TEST_FLAG(cpvt, CALL_FLAG_EARLY_AUDIO_ON) &&
+            (cpvt->state == CALL_STATE_INIT || cpvt->state == CALL_STATE_DIALING || cpvt->state == CALL_STATE_ALERTING)) {
+            ast_debug(1, "[%s] Outgoing call idx:%d - hangup cause %d\n", PVT_ID(pvt), cpvt->call_idx, cause);
+            ast_channel_hangupcause_set(cpvt->channel, cause);
+        }
+    }
+}
