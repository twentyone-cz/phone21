+/* Phone21: outgoing call - start PCM audio from the modem before the callee
+ * answers, so the caller hears the real ringback and network announcements
+ * (early media; SIMCom documents AT+CPCMREG=1 after ATD for the ringback).
+ * SimCom with serial PCM only, and only when the dialplan allowed it.
+ * CALL_FLAG_EARLY_AUDIO prevents a second activation on CALL_STATE_ACTIVE. */
+static void early_audio_start(struct cpvt* const cpvt, struct pvt* const pvt)
+{
+    if (!CPVT_DIR_OUTGOING(cpvt) || !CPVT_TEST_FLAG(cpvt, CALL_FLAG_EARLY_AUDIO_ON) || CPVT_TEST_FLAG(cpvt, CALL_FLAG_EARLY_AUDIO)) {
+        return;
+    }
+    if (!pvt->is_simcom || CONF_UNIQ(pvt, uac) != TRIBOOL_FALSE || !pvt->has_voice) {
+        return;
+    }
+    if (at_enqueue_cpcmreg(cpvt, 1)) {
+        ast_log(LOG_WARNING, "[%s] Unable to request early audio - idx:%d\n", PVT_ID(pvt), cpvt->call_idx);
+        return;
+    }
+    CPVT_SET_FLAG(cpvt, CALL_FLAG_EARLY_AUDIO);
+    ast_debug(1, "[%s] Early audio requested - idx:%d\n", PVT_ID(pvt), cpvt->call_idx);
+}
+
 static void change_state(struct cpvt* const cpvt, struct pvt* const pvt, struct ast_channel* const channel, const call_state_t oldstate,
                          const call_state_t newstate, const short call_idx, const int cause)
 {
@@ -289,12 +310,14 @@ static void change_state(struct cpvt* const cpvt, struct pvt* const pvt, struct
             cpvt_call_activate(cpvt);
             cpvt_control(cpvt, AST_CONTROL_PROGRESS);
             ast_setstate(channel, AST_STATE_DIALING);
+            early_audio_start(cpvt, pvt);
             break;
 
         case CALL_STATE_ALERTING:
             cpvt_call_activate(cpvt);
             cpvt_control(cpvt, AST_CONTROL_RINGING);
             ast_setstate(channel, AST_STATE_RINGING);
+            early_audio_start(cpvt, pvt);
             break;
 
         case CALL_STATE_INCOMING:
