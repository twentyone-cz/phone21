index c3eec26..d02d0da 100644
--- a/src/channel.c
+++ b/src/channel.c
@@ -242,6 +242,11 @@ static int channel_call(struct ast_channel* channel, const char* dest, attribute
 
     /* Phone21: early audio only when the dialplan asks for it (channel is locked by ast_call) */
     const int early_audio = ast_true(pbx_builtin_getvar_helper(channel, "QUECTEL_EARLY_AUDIO"));
+    /* Phone21: limit (seconds) for the modem to report ringing; a switched-off
+     * phone keeps the call in DIALING for minutes while the network plays an
+     * announcement the modem does not pass on. Cleared on ALERTING/ACTIVE. */
+    const char* const alert_timeout_var = pbx_builtin_getvar_helper(channel, "QUECTEL_ALERT_TIMEOUT");
+    const int alert_timeout             = alert_timeout_var ? atoi(alert_timeout_var) : 0;
 
     SCOPED_MUTEX(pvt_lock, &pvt->lock);
 
@@ -255,6 +260,11 @@ static int channel_call(struct ast_channel* channel, const char* dest, attribute
     if (early_audio) {
         CPVT_SET_FLAG(cpvt, CALL_FLAG_EARLY_AUDIO_ON);
     }
+    if (alert_timeout > 0) {
+        ast_channel_setwhentohangup_tv(channel, ast_tv(alert_timeout, 0));
+        CPVT_SET_FLAG(cpvt, CALL_FLAG_ALERT_TIMEOUT);
+        ast_debug(1, "[%s] Ringing expected within %d s\n", PVT_ID(pvt), alert_timeout);
+    }
     ast_debug(1, "[%s] Calling %s on %s\n", PVT_ID(pvt), dest, ast_channel_name(channel));
 
     int clir = 0;
diff --git a/src/cpvt.c b/src/cpvt.c
index ad669ec..83b931e 100644
--- a/src/cpvt.c
+++ b/src/cpvt.c
@@ -300,6 +300,21 @@ static void early_audio_start(struct cpvt* const cpvt, struct pvt* const pvt)
     ast_debug(1, "[%s] Early audio requested - idx:%d\n", PVT_ID(pvt), cpvt->call_idx);
 }
 
+/* Phone21: the modem reported ringing (or an answer) in time - drop the
+ * QUECTEL_ALERT_TIMEOUT hangup time set in channel_call(). Same lock order
+ * (pvt, then channel) as ast_queue_control() in cpvt_control(). */
+static void alert_timeout_clear(struct cpvt* const cpvt, struct pvt* const pvt, struct ast_channel* const channel)
+{
+    if (!CPVT_TEST_FLAG(cpvt, CALL_FLAG_ALERT_TIMEOUT)) {
+        return;
+    }
+    CPVT_RESET_FLAG(cpvt, CALL_FLAG_ALERT_TIMEOUT);
+    ast_channel_lock(channel);
+    ast_channel_setwhentohangup_tv(channel, ast_tv(0, 0));
+    ast_channel_unlock(channel);
+    ast_debug(1, "[%s] Ringing in time - idx:%d\n", PVT_ID(pvt), cpvt->call_idx);
+}
+
 static void change_state(struct cpvt* const cpvt, struct pvt* const pvt, struct ast_channel* const channel, const call_state_t oldstate,
                          const call_state_t newstate, const short call_idx, const int cause)
 {
@@ -314,6 +329,7 @@ static void change_state(struct cpvt* const cpvt, struct pvt* const pvt, struct
             break;
 
         case CALL_STATE_ALERTING:
+            alert_timeout_clear(cpvt, pvt, channel);
             cpvt_call_activate(cpvt);
             cpvt_control(cpvt, AST_CONTROL_RINGING);
             ast_setstate(channel, AST_STATE_RINGING);
@@ -325,6 +341,7 @@ static void change_state(struct cpvt* const cpvt, struct pvt* const pvt, struct
             break;
 
         case CALL_STATE_ACTIVE:
+            alert_timeout_clear(cpvt, pvt, channel);
