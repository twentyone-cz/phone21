+         * The reopen after that uses CLOCAL anyway (typ 1 on SimCom). */
+        pvt->audio_fd = tty_open(CONF_UNIQ(pvt, audio_tty), 1);
         if (pvt->audio_fd < 0) {
             goto cleanup_datafd;
         }
@@ -450,6 +457,13 @@ static void dev_manager_stop(struct public_state* const state)
 
 void pvt_on_create_1st_channel(struct pvt* pvt)
 {
+    /* Phone21: drop PCM left in the tty buffers from the previous call
+     * (nobody reads the port between calls), so the new call does not start
+     * with a burst of old audio */
+    if (CONF_UNIQ(pvt, uac) == TRIBOOL_FALSE && pvt->audio_fd >= 0) {
+        tcflush(pvt->audio_fd, TCIFLUSH);
+    }
+
     const struct ast_format* const fmt = pvt_get_audio_format(pvt);
     const size_t silence_buf_size      = 2u * pvt_get_audio_frame_size(PTIME_PLAYBACK, fmt);
     pvt->silence_buf                   = ast_calloc(1, silence_buf_size + AST_FRIENDLY_OFFSET);
