@@ -99,12 +100,26 @@ static int cmd_timeout_taskproc(void* tpdata) { return PVT_TASKPROC_TRYLOCK_AND_
 static int reopen_audio_port(struct pvt* pvt)
 {
     tty_close_lck(CONF_UNIQ(pvt, audio_tty), pvt->audio_fd, 0, 0);
-    pvt->audio_fd = tty_open(CONF_UNIQ(pvt, audio_tty), pvt->is_simcom);
+    /* Phone21: CLOCAL like the first open (pvt_start) on every modem */
+    pvt->audio_fd = tty_open(CONF_UNIQ(pvt, audio_tty), 1);
+
+    if (pvt->audio_fd >= 0) {
+        /* Phone21: non-blocking like after the first open (pvt_start),
+         * otherwise channel_read() may block in read() holding pvt->lock */
+        const int flags = fcntl(pvt->audio_fd, F_GETFL);
+        if (flags != -1) {
+            fcntl(pvt->audio_fd, F_SETFL, flags | O_NONBLOCK);
+        }
+    }
 
     if (!PVT_NO_CHANS(pvt)) {
         struct cpvt* cpvt;
         AST_LIST_TRAVERSE(&(pvt->chans), cpvt, entry) {
-            ast_channel_set_fd(cpvt->channel, 0, pvt->audio_fd);
+            /* Phone21: a call hung up by Asterisk stays in the list with
+             * channel == NULL until the modem reports its release */
+            if (cpvt->channel) {
+                ast_channel_set_fd(cpvt->channel, 0, pvt->audio_fd);
+            }
         }
     }
 
