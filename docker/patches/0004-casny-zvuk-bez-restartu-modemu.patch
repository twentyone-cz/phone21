+/* Phone21: is a task starting with this command waiting in the queue
+ * (behind the head)? */
+int at_queue_pending_cmd(const struct pvt* pvt, at_cmd_t cmd)
+{
+    const at_queue_task_t* task;
+    const at_queue_task_t* const head = AST_LIST_FIRST(&pvt->at_queue);
+
+    AST_LIST_TRAVERSE(&pvt->at_queue, task, entry) {
+        if (task != head && task->cmdsno && task->cmds[0].cmd == cmd) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
 int at_queue_timeout(const struct pvt* pvt, int* diff)
 {
     const at_queue_cmd_t* cmd = at_queue_head_cmd(pvt);
