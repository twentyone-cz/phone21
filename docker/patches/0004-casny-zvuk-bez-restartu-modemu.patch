diff --git a/src/monitor_thread.c b/src/monitor_thread.c
index 63a1a32..4a015b4 100644
--- a/src/monitor_thread.c
+++ b/src/monitor_thread.c
@@ -77,18 +77,28 @@ static int restart_monitor_taskproc(void* tpdata) { return PVT_TASKPROC_TRYLOCK_
 
 static void cmd_timeout(struct pvt* const pvt)
 {
+    /* Phone21: the monitor may queue this task twice for one timeout; act
+     * only when the head command was sent and its time really ran out */
+    int t;
+    if (at_queue_timeout(pvt, &t) || t > 0) {
+        return;
+    }
+
     const struct at_queue_cmd* const ecmd = at_queue_head_cmd(pvt);
     if (!ecmd || ecmd->length) {
         return;
     }
 
+    /* Phone21: at_response() removes (frees) the timed out task, ecmd too */
+    const int ignore = (ecmd->flags & ATQ_CMD_FLAG_IGNORE) ? 1 : 0;
+
     if (at_response(pvt, &pvt->empty_str, RES_TIMEOUT)) {
         ast_log(LOG_ERROR, "[%s] Fail to handle response\n", PVT_ID(pvt));
         pvt->terminate_monitor = 1;
         return;
     }
 
-    if (ecmd->flags & ATQ_CMD_FLAG_IGNORE) {
+    if (ignore) {
         return;
     }
 
