#!/usr/sbin/nft -f
#
# Phone21 — filtr provozu přicházejícího z privátní sítě.
# Ostatní rozhraní (domácí síť, lokální smyčka) tenhle soubor neřeší.

define TUN_IF    = "tailscale0"
define SIP_PORT  = 5060
define RTP_PORTS = 10000-10100
define TUN_TCP   = { 8090, 8091, 5232 }

# Idempotence: tabulku vyrob prázdnou, smaž a nadefinuj.
table inet phone21 {}
delete table inet phone21

table inet phone21 {

  # Prázdné řetězy; podle zvoleného přístupu do nich tunnel-firewall.sh
  # přidá pravidlo, které pustí dál všechno.
  chain tun_pre {
  }

  chain fwd_pre {
  }

  # Provoz z privátní sítě do miniserveru.
  chain tun_in {
    jump tun_pre
    ct state established,related accept
    ct state invalid drop
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept
    udp dport $SIP_PORT counter accept
    tcp dport $SIP_PORT counter accept
    udp dport $RTP_PORTS counter accept
    tcp dport $TUN_TCP counter accept
    limit rate 5/minute burst 5 packets log prefix "phone21-fw in: "
    counter drop
  }

  # Provoz z privátní sítě dál (do kontejnerů a do domácí sítě).
  # Publikované porty sem přijdou po překladu adresy.
  chain tun_fwd {
    jump fwd_pre
    ct state established,related accept
    ct state invalid drop
    ct status dnat tcp dport $TUN_TCP counter accept
    limit rate 5/minute burst 5 packets log prefix "phone21-fw fwd: "
    counter drop
  }

  chain input {
    type filter hook input priority filter; policy accept;
    iifname $TUN_IF jump tun_in
  }

  chain forward {
    type filter hook forward priority filter; policy accept;
    iifname $TUN_IF jump tun_fwd
  }
}
