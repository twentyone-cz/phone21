<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Registrace telefonního účtu. Na GrapheneOS je potřeba i tehdy, když
         účet NENÍ self-managed (jinak registrace skončí SecurityException). -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- Předání hovoru softphonu a testovací vytáčení z appky -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Historie hovorů v systémovém seznamu (a tím i v autě přes Bluetooth) -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />

    <!-- Softphone, kterému hovory předáváme -->
    <queries>
        <package android:name="org.linphone" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GatewayConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

    </application>
</manifest>
